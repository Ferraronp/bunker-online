digraph G { graph [label="Деятельность: партия от лобби до финала",labelloc=t,fontsize=19,fontname="DejaVu Sans",bgcolor="white",pad="0.35",rankdir=TB]; node [fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#e8f1fb",color="#6789a4"]; edge [fontname="DejaVu Sans",fontsize=10]; start[shape=circle,label="",style=filled,fillcolor="#31485d",width=.18]; a[label="Создать комнату FR-1"];b[label="Присоединиться FR-2"];c[shape=diamond,label="Игроков ≥ 2?",fillcolor="#fef3d4"];w[label="Ждать участников"];d[label="Начать партию FR-3\nраздать приватные карты"];e[label="Раскрывать карты FR-4"];f[label="Открыть голосование FR-6"];g[label="Отдать голоса FR-5"];h[label="Подвести итог"];i[shape=diamond,label="Ничья?",fillcolor="#fef3d4"];j[label="Второй тур"];k[label="Исключение / пропуск"];m[shape=diamond,label="Игра окончена?",fillcolor="#fef3d4"];end[label="Результат FR-9",fillcolor="#e5f6e7"];stop[shape=doublecircle,label="",width=.2]; start->a->b->c;c->w[label="нет"];w->c;c->d[label="да"];d->e->f->g->h->i;i->j[label="да"];j->k;i->k[label="нет"];k->m;m->e[label="нет",constraint=false];m->end[label="да"];end->stop;}
