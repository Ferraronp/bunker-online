digraph G {graph[label="Жизненный цикл комнаты — phase",labelloc=t,fontsize=19,fontname="DejaVu Sans",bgcolor="white",pad="0.5",rankdir=LR];node[fontname="DejaVu Sans",fontsize=12,shape=box,style="rounded,filled",fillcolor="#eaf2fb",color="#7894ae",height=.55];edge[fontname="DejaVu Sans",fontsize=9];start[shape=circle,label="",width=.2,height=.2,style=filled,fillcolor="#33485c"];lobby[label="lobby\nожидание игроков"];round[label="round\nраскрытие / обсуждение"];vote[label="voting\nголосование"];fin[label="finished\nфинал",fillcolor="#e2f5e5"];end[shape=doublecircle,label="",width=.2];start->lobby[label="создана (FR-1)"];lobby->round[label="start [игроков ≥ 2]"];round->vote[label="open_vote"];vote->round[label="resolve_vote\nпропуск/исключение"];vote->vote[label="ничья → второй тур"];round->round[label="next_round / reveal"];round->fin[label="finish / capacity"];vote->fin[label="finish / capacity"];fin->end[label="удаление"]; }
