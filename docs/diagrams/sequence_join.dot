digraph G {graph[label="US-2. Последовательность: присоединение",labelloc=t,fontsize=19,fontname="DejaVu Sans",bgcolor="white",pad=".35",rankdir=TB];node[fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#edf4fb",color="#809db9"];edge[fontname="DejaVu Sans",fontsize=10];a[label="1. Игрок → React\nввод кода и ника"];b[label="2. React → FastAPI\nPOST /api/rooms/{id}/join"];c[label="3. FastAPI → PostgreSQL\nнайти комнату и проверить ник"];d[shape=diamond,label="Валидный код и\nсвободный ник?",fillcolor="#fff2cb"];e[label="4. PostgreSQL\nсоздать Player и токен",fillcolor="#e3f5e5"];f[label="5. FastAPI → React\nHTTP 200 {id, token, player_id, spectator}",fillcolor="#e3f5e5"];g[label="6. React → Игрок\nоткрыть комнату",fillcolor="#e3f5e5"];err[label="HTTP 400 ник занят / 404 нет комнаты\nПоказать ошибку, не создавать Player",fillcolor="#ffebe8"];a->b->c->d;d->e[label="да"];e->f->g;d->err[label="нет"]; }
