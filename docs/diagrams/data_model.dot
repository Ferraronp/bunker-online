digraph G {graph[label="Модель данных: 3 SQL таблицы и 2 JSON-сущности",labelloc=t,fontsize=19,fontname="DejaVu Sans",bgcolor="white",pad="0.4",rankdir=LR];node[shape=record,fontname="DejaVu Sans",fontsize=10,style="filled",fillcolor="#eaf2fb",color="#7894ae"];edge[fontname="DejaVu Sans",fontsize=10];Pack[label="{Pack «SQL»|id : str\ltitle : str\lrevision : int\lcontent : JSON\lis_builtin : bool\l}"];Room[label="{Room «SQL»|id : str\ltitle : str\lphase : str\lhost_id : str\lpack_snapshot : JSON\lstate : JSON\lundo_stack : JSON\l}"];Player[label="{Player «SQL»|id : str\lroom_id : str\ltoken : str\lnickname : str\lspectator : bool\lalive : bool\lhand : JSON\l}"];Card[label="{Card «JSON Player.hand»|id : str\lcategory_id : str\lvalue : str\lrevealed : bool\l}",fillcolor="#fff3dc"];Vote[label="{Vote «JSON Room.state.votes»|voter_id : str\ltarget : player_id / skip\l}",fillcolor="#fff3dc"];Pack->Room[label="1 : 0..*\nsnapshot"];Room->Player[label="1 : 0..*\nparticipants"];Player->Card[label="1 : 0..*\nhand"];Room->Vote[label="1 : 0..*\nvotes",constraint=false];Vote->Player[label="voter/target",constraint=false,style=dashed];}
