digraph G {graph[label="US-5. Последовательность голосования и ошибка фазы",labelloc=t,fontsize=18,fontname="DejaVu Sans",bgcolor="white",pad=".35",rankdir=TB];node[fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",fillcolor="#edf4fb",color="#809db9"];edge[fontname="DejaVu Sans",fontsize=10];a[label="Игрок → React\nвыбор «Пропустить»"];b[label="React → FastAPI\nPOST /api/rooms/{id}/vote, target=skip"];c[label="FastAPI → PostgreSQL\nпроверка токена и фазы"];d[shape=diamond,label="Фаза voting\nи игрок активен?",fillcolor="#fff2cb"];e[label="game.cast_vote → Room.state.votes\nсохранить / изменить выбор",fillcolor="#e3f5e5"];f[label="HTTP 200 {ok:true}\nWebSocket sync → личный REST",fillcolor="#e3f5e5"];err[label="HTTP 400 «Голосовать сейчас нельзя»\nГолос не сохраняется",fillcolor="#ffebe8"];a->b->c->d;d->e[label="да"];e->f;d->err[label="нет"]; }
